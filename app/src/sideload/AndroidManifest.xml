<?xml version="1.0" encoding="utf-8"?>
<!--
  The SIDELOAD flavor's permissions, and only the sideload flavor's.

  This build is the one users install from the rolling GitHub Release, and it updates itself: it
  downloads the new APK and hands it to the system installer, silently through Shizuku where that is
  available. Both of those need permissions that must NOT appear in a Play build:

    - REQUEST_INSTALL_PACKAGES is a restricted permission, and Google Play forbids an app distributed
      on Play from updating itself outside Play.
    - moe.shizuku.manager.permission.API_V23 is the runtime grant Shizuku gives this app to call
      through its privileged service (the optional silent-install path).

  Keeping them in a flavor source set rather than gating them at runtime is the point: the Play
  artifact's manifest cannot carry them at all, and nothing in the Play artifact's code can install
  anything (the whole install path lives in this flavor's own source set too).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <application>
        <!-- Shizuku entry point, here and not in main: only this build has the library, the class and
             the runtime permission, and the Play build carries none of them.

             ShizukuProvider REQUIRES android:exported="true". It throws
             IllegalStateException("android:exported must be true") in attachInfo() at process start
             otherwise, which is a crash on launch. Exporting is safe: access is gated by the
             INTERACT_ACROSS_USERS_FULL signature-or-privileged permission, which normal apps cannot
             hold. This is the canonical Shizuku declaration. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
