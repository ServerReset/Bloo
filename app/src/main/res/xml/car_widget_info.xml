<?xml version="1.0" encoding="utf-8"?>
<!--
  AppWidgetProviderInfo for the adaptive Bloo car widget.
  Fully resizable in both axes; minWidth/minHeight sit at the 1x1 floor so the
  widget can be dropped tiny and grown all the way to a 7x7 dashboard, with the
  Glance content choosing a layout tier for whatever size it ends up.
  targetCellWidth/Height (Android 12+) give a sensible 3x2 default drop size.
  widgetFeatures="reconfigurable" (API 31+) is what actually makes launchers
  show a long-press "Widget settings" entry point for android:configure;
  without it, most stock/Pixel launchers silently omit that affordance even
  though the configure activity is declared.

  previewLayout (API 31+) and previewImage are BOTH declared on purpose. The
  picker's precedence is generated preview (API 35+) then previewLayout then
  previewImage then the launcher icon, so declaring both means Android 12+ gets
  the scalable layout and older hosts still get the drawable. Until previewLayout
  was added, the chain fell all the way through to previewImage and the picker
  advertised the entire widget as one static car glyph.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="640dp"
    android:maxResizeHeight="640dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="com.bloo.bluelink.widget.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:initialLayout="@layout/car_widget_loading"
    android:previewLayout="@layout/car_widget_preview"
    android:previewImage="@drawable/ic_car_hero"
    android:description="@string/widget_description" />
