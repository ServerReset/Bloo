<?xml version="1.0" encoding="utf-8"?>
<!--
  AppWidgetProviderInfo for the basic Bloo car widget.
  Fully resizable in both axes: minWidth/minHeight sit near a 1x1 floor so it
  can be dropped tiny (CarWidget.Content falls back to a compact one-row
  layout below ~80dp tall) and grown into a large dashboard-style tile.
  targetCellWidth/Height (Android 12+) give a sensible 3x1 default drop size.
  No android:configure attribute: this widget has no per-instance settings screen.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="640dp"
    android:maxResizeHeight="480dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/car_widget_loading"
    android:previewImage="@drawable/ic_car_hero"
    android:description="@string/widget_description" />
