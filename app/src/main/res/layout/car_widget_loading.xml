<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's initial layout: the single frame shown before Glance's own
  composition session has produced real content (and, if that session never
  completes on some devices, potentially the only frame ever shown -- see
  CarWidgetReceiver's own doc on the direct-by-id update fix for that history).
  Deliberately plain XML/RemoteViews, not Compose: Glance itself hasn't run
  yet at the point this is inflated.

  ?android:attr/colorBackground / ?android:attr/textColorPrimary follow the
  system's own light/dark widget host state, so this placeholder frame
  matches whichever theme the real Glance content will render into next.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:text="@string/app_name"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15sp" />

</FrameLayout>
