<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Optional: only used to set the weather location to the device's position.
         The app works fine without it (a place can be typed in Settings instead). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Bloo isn't on the Play Store, so the in-app update prompt downloads
         the new APK itself and launches the system package installer;
         needs this to be allowed to request an install at all on API 26+. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Runtime permission Shizuku grants the app to call through its privileged
         service (used for the optional silent-install update path). Harmless if the
         Shizuku manager app isn't installed — the whole path is gated on pingBinder(). -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- So we can detect the official apps and open web/dial/custom-tab links.
         Android 11+ hides other packages unless declared here; without these the
         digital-key and wallet apps can't be launched and we'd fall back to URLs. -->
    <queries>
        <package android:name="com.stationdm.bluelink" />
        <package android:name="com.stationdm.genesis" />
        <package android:name="com.myuvo.link" />
        <package android:name="com.hyundaiusa.hyundai.digitalcarkey" />
        <package android:name="com.genesisusa.genesis.digitalcarkey" />
        <package android:name="com.google.android.apps.walletnfcrel" />
        <package android:name="com.google.android.apps.wallet" />
        <package android:name="com.samsung.android.spay" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bloo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Bloo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Grants a share-sheet target (Drive, Files, email, etc.) temporary read
             access to an exported settings-backup file. Without this, "Export"
             could only share the backup as EXTRA_TEXT, which most file-saving
             targets don't accept as a share destination at all. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku entry point. Present so the app can "support Shizuku"; the
             INTERACT_ACROSS_USERS_FULL permission just protects the provider from
             other apps. Not exported. Only actually used when Shizuku is running
             and the user has opted into seamless install. -->
        <!-- ShizukuProvider REQUIRES android:exported="true" — it throws
             IllegalStateException("android:exported must be true") in attachInfo() at
             process start otherwise (crash on launch). Exporting is safe here: access
             is gated by the INTERACT_ACROSS_USERS_FULL signature|privileged permission,
             which normal apps can't hold. This is the canonical Shizuku declaration. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Wear OS Data Layer: receives the watch's remote commands and sync
             requests. Bound on-demand by Play Services when a /bloo message
             arrives, so it works even with the phone app closed. -->
        <service
            android:name=".wear.WearPhoneService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <!-- DATA_CHANGED is required for onDataChanged to fire at all: a
                     WearableListenerService only receives the Data Layer actions
                     its filter declares. Without it, every watch->phone DataItem
                     (climate draft, pebble order, AI/aurora toggles, local prefs)
                     is silently dropped. One <data> element covers both actions. -->
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/bloo" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.BlooTile1"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_car"
            android:label="Bloo tile 1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.BlooTile2"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_car"
            android:label="Bloo tile 2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.BlooTile3"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_car"
            android:label="Bloo tile 3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.BlooTile4"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_car"
            android:label="Bloo tile 4"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.BlooTile5"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_car"
            android:label="Bloo tile 5"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.BlooTile6"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_car"
            android:label="Bloo tile 6"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.BlooTile7"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_car"
            android:label="Bloo tile 7"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.BlooTile8"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_car"
            android:label="Bloo tile 8"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.BlooTile9"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_car"
            android:label="Bloo tile 9"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.BlooTile10"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_car"
            android:label="Bloo tile 10"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.BlooTile11"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_car"
            android:label="Bloo tile 11"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.BlooTile12"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_car"
            android:label="Bloo tile 12"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home-screen widget: pinned car status + four assignable pill buttons. -->
        <receiver
            android:name=".widget.BlooWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bloo_widget_info" />
        </receiver>

        <!-- Widget setup (on first drop AND launcher long-press → settings). -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Bloo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Transparent biometric/PIN gate for widget button taps. -->
        <activity
            android:name=".widget.WidgetAuthActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Bloo.Transparent" />

        <!-- Runs an alert notification's action button (e.g. Lock / Turn off),
             including taps bridged from the watch. -->
        <receiver
            android:name=".data.AlertActionReceiver"
            android:exported="false" />

        <!-- Transparent "open & send, then close" surface for Quick Settings tiles. -->
        <activity
            android:name=".tiles.TileActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Bloo.Transparent" />

    </application>

</manifest>
