<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates. Normal permission (no runtime prompt), but the
         notification is silently NOT promoted without it, so it is required for
         the charging bar to reach the status-bar chip and lock screen. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lets Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS show its "Allow"
         dialog directly (LiveCharge.requestBackgroundUnrestricted) instead of only a
         settings page the user has to find the toggle on themselves: a normal
         permission, no runtime prompt of its own, but the request intent won't
         resolve without it declared. Google's own Play policy restricts this
         permission's USE (not its declaration) to apps with a core function that
         genuinely needs to run unattended in the background, which describes exactly
         why it's needed here: the live charging bar and the door/service alerts are
         both background WorkManager polls this app cannot do without. Moot for
         distribution either way: Bloo isn't on the Play Store, so that policy
         doesn't gate this build at all. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Optional: only used to set the weather location to the device's position
         (the map's own "device location" blue dot also uses the FINE grant below).
         The app works fine without either (a place can be typed in Settings instead). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- AutoLock (app/.../autolock/): locks a car when the phone disconnects from its
         paired Bluetooth device, confirmed by Activity Recognition. Off by default per
         car and every permission below is requested only from AutoLock's own Settings
         section, only once the feature is actually turned on. -->
    <!-- Bluetooth disconnect trigger + the paired-device picker in Settings. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Activity Recognition confirmation (driving -> walking). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- The short-lived foreground service that runs while an evaluation (grace countdown,
         status check, lock) is in flight. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Bloo isn't on the Play Store, so the in-app update prompt downloads
         the new APK itself and launches the system package installer;
         needs this to be allowed to request an install at all on API 26+. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Runtime permission Shizuku grants the app to call through its privileged
         service (used for the optional silent-install update path). Harmless if the
         Shizuku manager app isn't installed — the whole path is gated on pingBinder(). -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- So we can detect the official apps and open web/dial/custom-tab links.
         Android 11+ hides other packages unless declared here; without these the
         digital-key and wallet apps can't be launched and we'd fall back to URLs. -->
    <queries>
        <package android:name="com.stationdm.bluelink" />
        <package android:name="com.stationdm.genesis" />
        <package android:name="com.myuvo.link" />
        <package android:name="com.hyundaiusa.hyundai.digitalcarkey" />
        <package android:name="com.genesisusa.genesis.digitalcarkey" />
        <package android:name="com.google.android.apps.walletnfcrel" />
        <package android:name="com.google.android.apps.wallet" />
        <package android:name="com.samsung.android.spay" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".BlooApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bloo">

        <!-- Shown by BlooApplication's uncaught exception handler in place of a
             silent crash; see its own doc. exported=false: only ever launched
             from inside this app's own process, right after it crashes. -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:theme="@style/Theme.Bloo" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Bloo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Grants a share-sheet target (Drive, Files, email, etc.) temporary read
             access to an exported settings-backup file. Without this, "Export"
             could only share the backup as EXTRA_TEXT, which most file-saving
             targets don't accept as a share destination at all. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku entry point. Present so the app can "support Shizuku"; the
             INTERACT_ACROSS_USERS_FULL permission just protects the provider from
             other apps. Not exported. Only actually used when Shizuku is running
             and the user has opted into seamless install. -->
        <!-- ShizukuProvider REQUIRES android:exported="true" — it throws
             IllegalStateException("android:exported must be true") in attachInfo() at
             process start otherwise (crash on launch). Exporting is safe here: access
             is gated by the INTERACT_ACROSS_USERS_FULL signature|privileged permission,
             which normal apps can't hold. This is the canonical Shizuku declaration. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Disables two androidx.startup auto-initializers that otherwise run as a
             ContentProvider's onCreate(), synchronously on the MAIN thread, during process
             attach, before Application.onCreate() and therefore before every deliberately
             off-main-thread scheduling call in MainActivity.

             WorkManagerInitializer opens WorkManager's own Room database and stands up its
             executors right there on the critical path to first frame. WorkManagerInit (see
             that class) now does the same init call on demand instead, from whichever call
             site needs a WorkManager first, see its doc for why every "get a WorkManager"
             call in this app must go through it.

             EmojiCompatInitializer sets up EmojiCompat's font-fallback machinery for legacy
             View-based text rendering (AppCompatTextView / EmojiTextView, or an explicit
             EmojiCompat.get().process() call). This app has neither: it is Compose-only for
             its own UI, has no androidx.appcompat dependency, and never references
             EmojiCompat anywhere in its source. Compose's own text rendering does not consult
             the EmojiCompat singleton at all, so this initializer's work was pure overhead on
             every cold start for a mechanism nothing in the app ever uses. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
            <!-- The provider itself STAYS, even though the two initializers above are
                 removed and it looks like dead weight on the pre-Application path.
                 androidx.profileinstaller registers ProfileInstallerInitializer through
                 this same provider, and that is what installs the merged AndroidX and
                 Compose baseline profiles. Removing the provider would silently take the
                 app's only AOT-compilation delivery mechanism with it, which is the
                 opposite of the startup win it looks like. -->
        </provider>

        <!-- Runs an alert notification's action button (e.g. Lock / Turn off). -->
        <receiver
            android:name=".data.AlertActionReceiver"
            android:exported="false" />

        <!-- AutoLock (see app/.../autolock/ and uses-permission block above). -->
        <!-- Manifest-declared (not registerReceiver at runtime): ACL connect/disconnect is
             one of the implicit broadcasts Android still delivers to a manifest receiver even
             with the app process dead, so this alone is what makes "phone disconnects from
             the car -> lock it" work with no persistent service running in between. -->
        <receiver
            android:name=".autolock.AutoLockBluetoothReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <!-- Activity Recognition transitions are delivered via an explicit PendingIntent
             built from this receiver, see ActivityRecognitionManager, so it needs no
             intent-filter here. -->
        <receiver android:name=".autolock.AutoLockActivityReceiver" android:exported="false" />
        <!-- Relaunches MainActivity once an in-place app update finishes installing;
             see its own doc comment. -->
        <receiver android:name=".autolock.AutoLockBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".autolock.AutoLockService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
