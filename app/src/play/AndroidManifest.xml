<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Background location is held out of the Play build until Google Play has approved its declaration (the Play
         Console refuses any release that asks for it before that). AutoLock's "Stay unlocked while you're beside it"
         row sees the permission is not in this build and says so (see AutoLockBesideCarRow); everything else in
         AutoLock works without it. Delete this file once the declaration is approved. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
</manifest>
